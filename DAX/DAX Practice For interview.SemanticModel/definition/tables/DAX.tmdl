table DAX
	lineageTag: fb564c53-a63d-42de-bb50-0990021c0922

	measure Rankx_inscope = ```
			
			
			var _seg = RANKX(
			    ALLSELECTED(financials[Segment]),
			    CALCULATE(
			        SUM(financials[Profit])
			    ),,DESC)
			
			var _country = RANKX(
			    ALLSELECTED(financials[Country]),
			    CALCULATE(
			        SUM(financials[Profit])
			    ),,DESC)
			
			var _product = RANKX(
			    ALLSELECTED(financials[Product]),
			    CALCULATE(
			        SUM(financials[Profit])
			    ),,DESC)
			
			var _result = SWITCH(
			    TRUE(),
			    ISINSCOPE(financials[Product]),_product,
			    ISINSCOPE(financials[Country]),_country,
			    ISINSCOPE(financials[Segment]),_seg,
			    0)
			
			RETURN IF(
			    HASONEVALUE(financials[Segment]) || 
			    HASONEVALUE(financials[Country]) || 
			    HASONEVALUE(financials[Product]),
			    _result,
			    BLANK())
			```
		formatString: 0
		lineageTag: 1169b45e-da91-4bc4-a9d1-1182250fa453

	measure Second_highest_with_name_in_string = ```
			
			
			var _agg_tab = SUMMARIZE(
			    financials,
			    financials[Segment],
			    "Total_profit",SUM(financials[Profit])
			)
			
			var _top_selected = TOPN(
			    SELECTEDVALUE(Series_table[Value_series],2),
			    _agg_tab,
			    [Total_profit],
			    DESC)
			
			var _top_1_only = TOPN(
			    1,
			    _top_selected,
			    [Total_profit],
			    ASC)
			
			RETURN MAXX(
			        _top_1_only,
			        financials[Segment])
			         
			         &": "&
			
			    MAXX(
			        _top_1_only,
			        [Total_profit]
			    )
			
			```
		lineageTag: 74eae86f-89c0-4e7a-a13b-7ab98052e277

