	measure Treatas_function = ```
			
			VAR min_val = 
			    CALCULATE(
			        MIN(Week_cal_table[Value]),
			        TREATAS(
			            VALUES(test_table[Category]),
			            Week_cal_table[Category]
			        )
			    )
			
			RETURN 
			    IF(
			        HASONEVALUE(test_table[Category]),
			        min_val,
			        BLANK()
			    )
			
			```
