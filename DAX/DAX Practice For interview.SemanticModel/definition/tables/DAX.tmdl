	measure week_on_week_comparison = ```
			
			CALCULATE(
			    SUM(Week_cal_table[Value]),
			FILTER(
			    ALL(Week_cal_table),
			    Week_cal_table[Category] = SELECTEDVALUE(Week_cal_table[Category]) &&
			    WEEKNUM(Week_cal_table[Date]) = WEEKNUM(MAX(Week_cal_table[Date])) - 1
			    )
			)
			
			```
		formatString: 0
		lineageTag: e52b0a23-a426-4c5a-9939-fff4bcda25e7

	measure Second_highest_rankx = ```
			
			
			var _agg_table = SUMMARIZE(
			    Week_cal_table,
			    Week_cal_table[Category],
			    "Total_value",SUM(Week_cal_table[Value]))
			
			var _rank_column_added_table = 
			    ADDCOLUMNS(
			        _agg_table,
			        "_rank",RANKX(_agg_table,
			            CALCULATE(SUM(Week_cal_table[Value])),
			            ,DESC))
			
			var _second_highest_only = FILTER(
			    _rank_column_added_table,
			    [_rank] = 2)
			
			RETURN MAXX(_second_highest_only,Week_cal_table[Category]) & ": " & 
			       MAXX(_second_highest_only,[Total_value])
			```
		lineageTag: 063a3563-a401-4b15-985f-4e1ef1a7130e

