table test_table_rank
	lineageTag: 5a9fcd94-2a2b-4853-822c-46e7e3a270f7

	column Segment
		lineageTag: 8ff3a6da-638a-4ffc-b658-fb59a682d5d0
		summarizeBy: none
		isNameInferred
		sourceColumn: financials[Segment]

		annotation SummarizationSetBy = Automatic

	column Total_value
		formatString: #,0
		lineageTag: 7cf5530a-a4cb-43c2-877d-660e92b998d1
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Total_value]

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDecimal":true}

	column _rank
		formatString: 0
		lineageTag: e6c9fa04-a9f0-4177-9482-2c8d29dc5989
		summarizeBy: sum
		isNameInferred
		sourceColumn: [_rank]

		annotation SummarizationSetBy = Automatic

	partition test_table_rank = calculated
		mode: import
		source =
				ADDCOLUMNS(
				SUMMARIZE(
				    financials,
				    financials[Segment],
				    "Total_value",SUM(financials[Profit])
				),
				"_rank",RANKX(
				    ALL(financials[Segment]),
				    CALCULATE(SUM(financials[Profit])),
				    ,DESC))

	annotation PBI_Id = 0e66acafe6ff46a28ebab53baa26c1e9

