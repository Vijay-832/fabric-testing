table DAX2
	lineageTag: 15ff58ca-3ead-4084-8309-3374bb00a84a

	measure Rankx_practice = ```
			
			
			var _seg = RANKX(
			    ALL(financials[Segment]),
			    CALCULATE(SUM(financials[Profit])),
			    ,DESC)
			
			var _country = RANKX(
			    ALL(financials[Country]),
			    CALCULATE(SUM(financials[Profit])),,
			    DESC)
			
			var _product = RANKX(
			    ALL(financials[Product]),
			    CALCULATE(SUM(financials[Profit])),
			    ,DESC)
			
			var _result = SWITCH(
			    TRUE(),
			    ISINSCOPE(financials[Product]),_product,
			    ISINSCOPE(financials[Country]),_country,
			    ISINSCOPE(financials[Segment]),_seg,
			    0)
			
			RETURN 
			IF(
			    HASONEVALUE(financials[Segment]) ||
			    HASONEVALUE(financials[Country]) ||
			    HASONEVALUE(financials[Product]),
			    _result,
			    BLANK())
			```
		formatString: 0
		lineageTag: 01d37d6e-43e1-4930-99de-48fe6517b7dd

	measure Second_highest =
			
			
			var _agg_table = ADDCOLUMNS(
			SUMMARIZE(
			    financials,
			    financials[Segment],
			    "Total_profit",SUM(financials[Profit])
			),
			"_rank",RANKX(
			    ALL(financials[Segment]),
			    CALCULATE(SUM(financials[Profit])),,
			    DESC)
			)
			
			var second_highest = FILTER(
			    _agg_table,
			    [_rank] = 2
			)
			
			RETURN MAXX(second_highest,[Total_profit])
		lineageTag: 64d330d0-012e-4528-bf93-1e4272841d60

		annotation PBI_FormatHint = {"isGeneralNumber":true}

